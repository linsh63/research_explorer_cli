{
  "name": "research-explorer-cli",
  "version": "0.1.0-alpha.4",
  "private": false,
  "type": "module",
  "description": "Research Explorer CLI: a Pi-based interface for the Auto Research Agent core.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "rexplore": "dist/launcher.js"
  },
  "exports": {
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/architecture/",
    "docs/core-api-gaps.md",
    "docs/planning/",
    "docs/reports/stages/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "validate:c0": "node scripts/validate-c0.mjs",
    "validate:c1": "node scripts/validate-c1.mjs",
    "validate:c2": "node scripts/validate-c2.mjs",
    "validate:c3": "node scripts/validate-c3.mjs",
    "validate:c4": "node scripts/validate-c4.mjs",
    "prepack": "npm run build && npm run check:boundaries"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "typebox": "1.3.7",
    "@earendil-works/pi-tui": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linsh63/research_explorer_cli.git"
  },
  "researchExplorer": {
    "compatibility": {
      "pi": "1.0.2",
      "coreService": "1.0.0",
      "publicSchema": "1.0.0"
    }
  }
}
